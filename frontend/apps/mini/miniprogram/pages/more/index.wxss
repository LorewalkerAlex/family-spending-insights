.more-page {
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}

.more-header {
  margin-bottom: 26rpx;
}

.more-tools__header,
.theme-section__header {
  margin-top: 0;
}

.more-section-hint,
.theme-section__hint,
.more-tool__title,
.more-tool__body,
.theme-option__name,
.theme-option__selected,
.theme-option__description {
  display: block;
}

.more-section-hint,
.theme-section__hint {
  color: var(--color-text-muted);
  font-size: 22rpx;
}

.more-tools {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-bottom: 42rpx;
}

.more-tool {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 28rpx 28rpx;
}

.more-tool__icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: var(--color-accent-subtle);
  color: var(--color-accent);
  font-size: 38rpx;
  font-weight: 700;
}

.more-tool--schedule .more-tool__icon {
  background: var(--hero-background);
  color: var(--hero-foreground);
}

.more-tool__copy {
  min-width: 0;
  flex: 1;
}

.more-tool__title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.more-tool__title {
  font-size: 31rpx;
  font-weight: 700;
}

.more-tool__arrow {
  flex: none;
  color: var(--color-text-subtle);
  font-size: 42rpx;
  line-height: 1;
}

.more-tool__body {
  margin-top: 8rpx;
  color: var(--color-text-muted);
  font-size: 23rpx;
  line-height: 1.55;
}

.theme-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.theme-option {
  box-sizing: border-box;
  width: calc(50% - 9rpx);
  min-width: 0;
  padding: 22rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-medium);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.theme-option--active {
  border-color: var(--color-accent);
  background: var(--color-accent-subtle);
}

.theme-option__swatches {
  display: flex;
  overflow: hidden;
  height: 42rpx;
  border-radius: 14rpx;
}

.theme-option__swatch {
  flex: 1;
}

.theme-option__copy {
  margin-top: 18rpx;
}

.theme-option__title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.theme-option__name {
  font-size: 28rpx;
  font-weight: 700;
}

.theme-option__selected {
  flex: none;
  color: var(--color-accent);
  font-size: 20rpx;
  font-weight: 700;
}

.theme-option__description {
  margin-top: 7rpx;
  overflow: hidden;
  color: var(--color-text-muted);
  font-size: 21rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}