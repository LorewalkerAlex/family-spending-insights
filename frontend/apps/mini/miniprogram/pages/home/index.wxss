.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 40rpx 32rpx 72rpx;
}

.page-header {
  margin-bottom: 32rpx;
}

.eyebrow,
.title,
.subtitle,
.summary-card__label,
.summary-card__month,
.summary-card__environment,
.cashflow-block__label,
.cashflow-block__value,
.cashflow-block__meta,
.metric-card__label,
.metric-card__value,
.state-card__kicker,
.state-card__title,
.state-card__body,
.next-card__label,
.next-card__title,
.next-card__body {
  display: block;
}

.eyebrow {
  margin-bottom: 14rpx;
  color: #6e7b72;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.title {
  color: #152019;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.16;
  letter-spacing: -1rpx;
}

.subtitle {
  max-width: 620rpx;
  margin-top: 18rpx;
  color: #69736c;
  font-size: 28rpx;
  line-height: 1.65;
}

.status {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 26rpx;
  padding: 12rpx 18rpx;
  border: 1rpx solid #d9ded9;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #59635c;
  font-size: 24rpx;
}

.status__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #9ca59f;
}

.status--connected {
  border-color: #c8ddcf;
  color: #2e6b47;
}

.status--connected .status__dot {
  background: #37a265;
}

.status--error {
  border-color: #ebd0cb;
  color: #9b4338;
}

.status--error .status__dot {
  background: #cf5b4d;
}

.summary-card,
.state-card,
.next-card {
  border: 1rpx solid rgba(32, 54, 41, 0.08);
  border-radius: 34rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 60rpx rgba(45, 64, 52, 0.06);
}

.summary-card {
  padding: 34rpx;
}

.summary-card__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.summary-card__label,
.cashflow-block__label,
.metric-card__label,
.next-card__label {
  color: #7a847d;
  font-size: 23rpx;
  font-weight: 600;
}

.summary-card__month {
  margin-top: 8rpx;
  color: #1c2921;
  font-size: 34rpx;
  font-weight: 650;
}

.summary-card__environment {
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  background: #eef4ef;
  color: #4d6d58;
  font-size: 21rpx;
}

.cashflow-block {
  margin-top: 46rpx;
  padding-bottom: 36rpx;
  border-bottom: 1rpx solid #edf0ed;
}

.cashflow-block__value {
  margin-top: 10rpx;
  color: #25342b;
  font-size: 64rpx;
  font-weight: 720;
  letter-spacing: -2rpx;
}

.cashflow-block__value--positive {
  color: #246743;
}

.cashflow-block__value--negative {
  color: #a3453b;
}

.cashflow-block__meta {
  margin-top: 10rpx;
  color: #8a938d;
  font-size: 23rpx;
}

.metric-grid {
  display: flex;
  gap: 18rpx;
  margin-top: 26rpx;
}

.metric-card {
  flex: 1;
  padding: 26rpx;
  border-radius: 24rpx;
  background: #f7f9f6;
}

.metric-card__value {
  margin-top: 10rpx;
  color: #253229;
  font-size: 32rpx;
  font-weight: 650;
}

.state-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 42rpx 36rpx;
}

.state-card__spinner {
  width: 38rpx;
  height: 38rpx;
  margin-bottom: 24rpx;
  border: 5rpx solid #e1e7e2;
  border-top-color: #3f7658;
  border-radius: 50%;
}

.state-card__kicker {
  color: #a05a4e;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.state-card__title {
  margin-top: 8rpx;
  color: #243128;
  font-size: 34rpx;
  font-weight: 650;
}

.state-card__body {
  margin-top: 14rpx;
  color: #717a74;
  font-size: 25rpx;
  line-height: 1.6;
  word-break: break-all;
}

.primary-button {
  margin: 30rpx 0 0;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: #2d694b;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 76rpx;
}

.next-card {
  margin-top: 24rpx;
  padding: 32rpx;
  background: #edf2eb;
}

.next-card__title {
  margin-top: 8rpx;
  color: #243128;
  font-size: 30rpx;
  font-weight: 650;
}

.next-card__body {
  margin-top: 12rpx;
  color: #657068;
  font-size: 25rpx;
  line-height: 1.65;
}
