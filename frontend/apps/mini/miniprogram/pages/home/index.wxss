.home-page {
  padding-top: 26rpx;
}

.home-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.home-header__eyebrow,
.home-header__title,
.summary-card__month,
.review-card__title,
.review-card__body,
.review-card__badge,
.review-card__chevron {
  display: block;
}

.home-header__eyebrow {
  color: var(--color-text-muted);
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.home-header__title {
  margin-top: 6rpx;
  font-size: 38rpx;
  font-weight: 700;
}

.home-header__theme {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  width: 72rpx;
  height: 72rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 24rpx;
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.theme-dot {
  width: 13rpx;
  height: 30rpx;
  border-radius: 999rpx;
  transform: rotate(20deg);
}

.theme-dot--ambient {
  background: var(--color-ambient-1);
}

.theme-dot--accent {
  background: var(--color-accent);
}

.theme-dot--cool {
  background: var(--color-ambient-2);
}

.summary-card {
  overflow: hidden;
  padding: 34rpx 34rpx 0;
  border-radius: var(--radius-large);
  background: var(--hero-background);
  color: var(--hero-foreground);
  box-shadow: var(--shadow-hero);
}

.summary-card__topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.money-label,
.metric-label {
  color: var(--hero-muted);
  font-size: 24rpx;
  font-weight: 600;
}

.summary-card__month {
  color: var(--hero-muted);
  font-size: 22rpx;
}

.money-value--hero {
  margin-top: 12rpx;
  color: var(--hero-foreground);
  font-size: 68rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -2rpx;
}

.summary-card__metrics {
  display: flex;
  align-items: stretch;
  margin: 34rpx -34rpx 0;
  border-top: 1rpx solid var(--hero-line);
}

.summary-card__metric {
  flex: 1;
  min-width: 0;
  padding: 26rpx 34rpx 28rpx;
}

.summary-card__divider {
  width: 1rpx;
  background: var(--hero-line);
}

.metric-value {
  margin-top: 8rpx;
  color: var(--hero-foreground);
  font-size: 30rpx;
  font-weight: 700;
}

.metric-value--positive,
.metric-value--neutral {
  color: var(--hero-foreground);
}

.metric-value--negative {
  color: var(--hero-negative);
}

.review-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 26rpx;
  padding: 28rpx 30rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-medium);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.review-card--attention {
  border-color: var(--color-border-strong);
  background: linear-gradient(135deg, var(--color-accent-subtle), var(--color-surface));
}

.review-card__copy {
  flex: 1;
  min-width: 0;
}

.review-card__title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.review-card__title {
  font-size: 29rpx;
  font-weight: 700;
}

.review-card__badge {
  min-width: 36rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: var(--color-accent);
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 32rpx;
  text-align: center;
}

.review-card__body {
  margin-top: 8rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.review-card__chevron {
  color: var(--color-text-muted);
  font-size: 46rpx;
  font-weight: 400;
}

.transaction-list {
  overflow: hidden;
}

.transaction-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 104rpx;
  padding: 22rpx 28rpx;
}

.transaction-row--divided {
  border-top: 1rpx solid var(--color-border);
}

.transaction-row__main {
  flex: 1;
  min-width: 0;
}

.transaction-name {
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.transaction-meta {
  margin-top: 7rpx;
  overflow: hidden;
  color: var(--color-text-muted);
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.transaction-amount {
  flex: none;
  font-size: 27rpx;
  font-weight: 700;
}

.transaction-amount--income {
  color: var(--color-positive);
}

.transaction-amount--expense {
  color: var(--color-text);
}

.state-card--compact {
  padding: 30rpx;
}

.state-card--compact .state-title {
  font-size: 29rpx;
}
