.detail-page {
  padding-top: 28rpx;
}

.detail-hero {
  box-sizing: border-box;
  padding: 34rpx 32rpx 36rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 32rpx;
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.detail-hero__topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.detail-hero__type {
  color: var(--color-text-muted);
  font-size: 24rpx;
  font-weight: 600;
}

.detail-badge {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--color-surface-subtle);
  color: var(--color-warning);
  font-size: 21rpx;
  font-weight: 700;
}

.detail-hero__amount,
.detail-hero__name,
.detail-hero__date,
.detail-row__label,
.detail-row__value,
.detail-note__text,
.review-status__title,
.review-status__signal,
.review-status__body {
  display: block;
}

.detail-hero__amount {
  margin-top: 18rpx;
  font-size: 66rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
}

.detail-hero__amount--positive {
  color: var(--color-positive);
}

.detail-hero__amount--negative {
  color: var(--color-text);
}

.detail-hero__name {
  margin-top: 18rpx;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
}

.detail-hero__date {
  margin-top: 8rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
}

.detail-section-header {
  margin-top: 34rpx;
}

.detail-list {
  overflow: hidden;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 28rpx;
  padding: 25rpx 28rpx;
}

.detail-row--divided {
  border-top: 1rpx solid var(--color-border);
}

.detail-row--stacked {
  display: block;
}

.detail-row__label {
  flex: none;
  color: var(--color-text-muted);
  font-size: 24rpx;
}

.detail-row__value {
  min-width: 0;
  color: var(--color-text);
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.5;
  text-align: right;
}

.detail-row--stacked .detail-row__value {
  margin-top: 12rpx;
  text-align: left;
}

.detail-row__value--long {
  word-break: break-all;
}

.detail-row__value--attention {
  color: var(--color-warning);
}

.detail-note,
.review-status {
  padding: 28rpx;
}

.detail-note__text {
  color: var(--color-text);
  font-size: 26rpx;
  line-height: 1.65;
  word-break: break-all;
}

.review-status--attention {
  border-color: var(--color-warning);
}

.review-status__title {
  font-size: 27rpx;
  font-weight: 700;
}

.review-status__signal {
  margin-top: 12rpx;
  color: var(--color-warning);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.5;
}

.review-status__body {
  margin-top: 10rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
  line-height: 1.55;
}
