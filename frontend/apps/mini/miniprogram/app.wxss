button {
  font: inherit;
}

button::after {
  border: 0;
}

.page-container {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--color-canvas);
  color: var(--color-text);
  transition: background-color 160ms ease;
}

.page-intro {
  margin-bottom: 32rpx;
}

.page-kicker,
.page-title,
.page-subtitle,
.section-title,
.section-action,
.money-label,
.money-value,
.money-meta,
.metric-label,
.metric-value,
.transaction-name,
.transaction-meta,
.transaction-amount,
.state-title,
.state-body,
.placeholder-label,
.placeholder-title,
.placeholder-body {
  display: block;
}

.page-kicker {
  color: var(--color-text-muted);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.page-title {
  margin-top: 10rpx;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -1rpx;
}

.page-subtitle {
  margin-top: 14rpx;
  color: var(--color-text-muted);
  font-size: 26rpx;
  line-height: 1.6;
}

.surface-card {
  box-sizing: border-box;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-large);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 40rpx 2rpx 18rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
}

.section-action {
  color: var(--color-accent);
  font-size: 25rpx;
  font-weight: 600;
}

.primary-action,
.secondary-action {
  box-sizing: border-box;
  min-height: 88rpx;
  margin: 0;
  padding: 0 30rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.primary-action {
  background: var(--color-accent);
  color: #ffffff;
}

.secondary-action {
  border: 1rpx solid var(--color-border);
  background: var(--color-surface);
  color: var(--color-text);
}

.state-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 44rpx 36rpx;
}

.state-indicator {
  width: 20rpx;
  height: 20rpx;
  margin-bottom: 24rpx;
  border-radius: 50%;
  background: var(--color-accent);
}

.state-indicator--error {
  background: var(--color-negative);
}

.state-title {
  font-size: 34rpx;
  font-weight: 700;
}

.state-body {
  margin-top: 14rpx;
  color: var(--color-text-muted);
  font-size: 25rpx;
  line-height: 1.6;
  word-break: break-all;
}

.state-card .primary-action,
.state-card .secondary-action {
  margin-top: 28rpx;
}

.placeholder-card {
  padding: 40rpx 34rpx;
}

.placeholder-label {
  color: var(--color-accent);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.placeholder-title {
  margin-top: 12rpx;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.3;
}

.placeholder-body {
  margin-top: 16rpx;
  color: var(--color-text-muted);
  font-size: 26rpx;
  line-height: 1.65;
}
