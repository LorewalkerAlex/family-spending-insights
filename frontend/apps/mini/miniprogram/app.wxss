page {
  --color-canvas: #f9ffef;
  --color-surface: #ffffff;
  --color-surface-subtle: #eff8e6;
  --color-text: #171b24;
  --color-text-muted: #697063;
  --color-text-subtle: #929989;
  --color-border: #dfe8d6;
  --color-border-strong: #c3cfb8;
  --color-accent: #5b4fff;
  --color-accent-subtle: #eeebff;
  --color-ambient-1: #dfff3f;
  --color-ambient-2: #66e6ff;
  --color-positive: #13a55f;
  --color-negative: #e34867;
  --color-warning: #d88900;
  --hero-background: linear-gradient(135deg, #efff55 0%, #b8ff67 42%, #66e6ff 100%);
  --hero-foreground: #18213a;
  --hero-muted: rgba(24, 33, 58, 0.66);
  --hero-line: rgba(24, 33, 58, 0.14);
  --hero-negative: #c91f4b;
  --shadow-card: 0 16rpx 42rpx rgba(92, 108, 68, 0.08);
  --shadow-hero: 0 28rpx 72rpx rgba(108, 139, 70, 0.20);
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-6: 48rpx;
  --space-8: 64rpx;
  --radius-small: 12rpx;
  --radius-medium: 20rpx;
  --radius-large: 28rpx;
  min-height: 100%;
  background: var(--color-canvas);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

