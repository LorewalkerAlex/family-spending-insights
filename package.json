{
  "name": "family-spending-insights-local-dashboard",
  "private": true,
  "workspaces": [
    "frontend/apps/*",
    "frontend/packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-runtime.mjs start",
    "dev:status": "node scripts/dev-runtime.mjs status",
    "dev:stop": "node scripts/dev-runtime.mjs stop",
    "dev:restart": "node scripts/dev-runtime.mjs restart",
    "dev:web": "npm run dev --workspace @family-spending/web",
    "build:web": "npm run build --workspace @family-spending/web",
    "test:web": "npm run test --workspace @family-spending/web",
    "typecheck:web": "npm run typecheck --workspace @family-spending/web",
    "dev:mini:h5": "npm run dev:h5 --workspace @family-spending/mini",
    "dev:mini:weapp": "npm run dev:weapp --workspace @family-spending/mini",
    "build:mini:h5": "npm run build:h5 --workspace @family-spending/mini",
    "build:mini:weapp": "npm run build:weapp --workspace @family-spending/mini",
    "test:mini": "npm run test --workspace @family-spending/mini",
    "typecheck:mini": "npm run typecheck --workspace @family-spending/mini",
    "test:frontend": "npm run test --workspaces --if-present",
    "typecheck:frontend": "npm run typecheck --workspaces --if-present",
    "test:dev-runtime": "node --test scripts/dev-runtime.test.mjs"
  },
  "dependencies": {
    "chart.js": "4.5.1"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "vitest": "4.1.10"
  }
}
