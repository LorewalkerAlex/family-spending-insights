# 环境变量和凭据
.env
.env.*
!.env.example

# 历史本地私有产物
cmb_bill_output/
mapping_output/

# 私人图片
/微信图片_*.jpg

# Python 和 uv 缓存
.uv-cache/
__pycache__/
*.pyc

# JavaScript 依赖与构建缓存
node_modules/
.swc/
/frontend/apps/*/dist/

# 本地开发运行态
.runtime/

# 本地文档默认忽略；Canonical Architecture 与其历史归档纳入 Git
docs/*
!docs/architecture/
!docs/architecture/**
!docs/archive/
!docs/archive/architecture/
!docs/archive/architecture/**

# Canonical household data 全部属于本地持久化状态，不进入 Git。
# Mapping 也位于 data/state/mappings/，与 application checkout 解耦。
data/

# 临时文件
tmp/
