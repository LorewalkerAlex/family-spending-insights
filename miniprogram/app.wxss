page {
  background: #f7f7f5;
  color: #20211f;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}
.page-shell { min-height: 100vh; padding: 28rpx 28rpx 48rpx; box-sizing: border-box; }
.card { background: #fff; border: 1rpx solid #ecece7; border-radius: 24rpx; box-shadow: 0 8rpx 28rpx rgba(37, 48, 43, .05); }
.muted { color: #8b8d87; }
.expense { color: #20211f; }
.refund { color: #268366; }
button::after { border: none; }
