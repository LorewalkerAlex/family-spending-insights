.top-row { display:flex; align-items:center; justify-content:space-between; margin: 8rpx 4rpx 28rpx; }
.eyebrow { color:#868982; font-size:23rpx; letter-spacing:2rpx; margin-bottom:8rpx; }
.month-picker { font-size:42rpx; font-weight:700; letter-spacing:-1rpx; }
.chevron { color:#6c706b; font-size:30rpx; margin-left:8rpx; }
.count-pill { padding:12rpx 20rpx; border-radius:999rpx; background:#e8f1ed; color:#1f6f5f; font-size:24rpx; }
.summary { padding:30rpx; background:linear-gradient(135deg,#153f36,#246d5d); color:#fff; }
.summary-main { display:flex; flex-direction:column; padding-bottom:26rpx; }
.summary-label { color:rgba(255,255,255,.68); font-size:24rpx; }
.summary-value { font-size:54rpx; line-height:1.3; font-weight:700; margin-top:4rpx; }
.summary-grid { display:grid; grid-template-columns:repeat(3,1fr); border-top:1rpx solid rgba(255,255,255,.16); padding-top:22rpx; }
.summary-grid > view { display:flex; flex-direction:column; }
.summary-small-label { font-size:22rpx; color:rgba(255,255,255,.58); }
.summary-small-value { font-size:27rpx; margin-top:7rpx; }
.search-row { margin-top:26rpx; }
.search-box { height:76rpx; display:flex; align-items:center; padding:0 24rpx; border-radius:20rpx; background:#fff; border:1rpx solid #e8e9e4; }
.search-box input { flex:1; font-size:27rpx; }
.search-icon { color:#999c96; font-size:34rpx; margin-right:14rpx; }
.filter-strip { white-space:nowrap; margin:20rpx 0 8rpx; }
.filter-chip { display:inline-block; padding:13rpx 24rpx; margin-right:14rpx; background:#eceeea; color:#676a65; border-radius:999rpx; font-size:24rpx; }
.filter-chip.active { color:#fff; background:#1f6f5f; }
.date-section { margin-top:28rpx; }
.date-label { color:#777a74; font-size:24rpx; margin:0 8rpx 12rpx; }
.transaction-list { overflow:hidden; }
.transaction-row { display:flex; padding:24rpx 22rpx; }
.transaction-row + .transaction-row { border-top:1rpx solid #f0f0ec; }
.merchant-avatar { width:72rpx; height:72rpx; flex:none; display:flex; align-items:center; justify-content:center; border-radius:20rpx; background:#edf3f0; color:#1f6f5f; font-weight:700; }
.transaction-copy { min-width:0; flex:1; margin-left:20rpx; }
.merchant-line { display:flex; align-items:flex-start; justify-content:space-between; gap:18rpx; }
.merchant-name { max-width:410rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:28rpx; font-weight:600; }
.amount { flex:none; font-size:29rpx; font-weight:650; }
.meta-line { display:flex; color:#92948e; font-size:22rpx; margin-top:9rpx; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.dot { margin:0 8rpx; }
.pending-tag { display:inline-block; margin-top:10rpx; padding:4rpx 10rpx; border-radius:8rpx; background:#fff4df; color:#a56a16; font-size:20rpx; }
.empty-state { text-align:center; color:#989a95; padding:100rpx 0; }
