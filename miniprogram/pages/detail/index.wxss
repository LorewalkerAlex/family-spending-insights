.hero { padding:38rpx 30rpx; text-align:center; }
.hero-date { color:#8c8f89; font-size:23rpx; }
.hero-merchant { font-size:34rpx; font-weight:650; margin-top:18rpx; }
.hero-amount { font-size:56rpx; font-weight:720; margin-top:12rpx; }
.status-row { display:flex; align-items:center; justify-content:center; gap:16rpx; margin-top:18rpx; font-size:22rpx; }
.status-pill { background:#e9f2ee; color:#1f6f5f; padding:7rpx 14rpx; border-radius:999rpx; }
.section-title { color:#777a74; font-size:24rpx; margin:30rpx 8rpx 12rpx; }
.form-card,.raw-card { padding:0 26rpx; }
.field { min-height:92rpx; display:flex; align-items:center; justify-content:space-between; gap:26rpx; }
.field + .field,.raw-row + .raw-row { border-top:1rpx solid #f0f0ec; }
.field-label { color:#777a74; width:150rpx; flex:none; }
.field input { flex:1; text-align:right; }
.picker-value,.field-value { text-align:right; color:#272926; }
.raw-row { display:flex; align-items:flex-start; justify-content:space-between; gap:30rpx; padding:24rpx 0; color:#777a74; }
.raw-row text:last-child { max-width:450rpx; text-align:right; color:#30322f; word-break:break-all; }
.save-button { margin-top:36rpx; background:#1f6f5f; color:#fff; border-radius:18rpx; font-size:29rpx; }
.save-note { color:#9a9c97; text-align:center; font-size:21rpx; line-height:1.6; margin:18rpx 28rpx; }
