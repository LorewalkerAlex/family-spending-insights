.review-header { display:flex; align-items:center; justify-content:space-between; margin:8rpx 4rpx 16rpx; }
.eyebrow { color:#868982; font-size:23rpx; letter-spacing:2rpx; margin-bottom:8rpx; }
.title { font-size:40rpx; font-weight:700; }
.reset-button { margin:0; padding:0 20rpx; height:58rpx; line-height:58rpx; background:#eceeea; color:#696c67; border-radius:999rpx; font-size:22rpx; }
.intro { color:#8a8d87; line-height:1.65; font-size:23rpx; margin:0 4rpx 28rpx; }
.review-card { padding:26rpx; margin-bottom:22rpx; }
.review-top { display:flex; justify-content:space-between; }
.review-date,.source-label { color:#92958f; font-size:22rpx; }
.review-amount { font-weight:700; }
.source-label { margin-top:24rpx; }
.source-merchant { font-size:29rpx; font-weight:650; margin-top:6rpx; }
.arrow { text-align:center; color:#9ba09b; margin:12rpx 0; }
.edit-field { min-height:84rpx; display:flex; align-items:center; justify-content:space-between; border-top:1rpx solid #f0f0ec; }
.edit-field > text { color:#7b7e78; }
.edit-field input,.edit-field picker { width:430rpx; text-align:right; }
.confidence { display:flex; align-items:center; gap:14rpx; color:#92958f; font-size:21rpx; margin-top:12rpx; }
.status-tag { padding:5rpx 10rpx; border-radius:8rpx; background:#fff1dc; color:#9b681c; }
.actions { display:grid; grid-template-columns:1fr 2fr; gap:16rpx; margin-top:24rpx; }
.actions button { font-size:27rpx; border-radius:16rpx; }
.ignore { background:#eff0ed; color:#70736e; }
.confirm { background:#1f6f5f; color:#fff; }
.empty-state { padding:80rpx 20rpx; text-align:center; color:#8d908a; }
.decided-title { margin:38rpx 6rpx 14rpx; color:#777a74; font-size:24rpx; }
.decided-row { display:flex; align-items:center; justify-content:space-between; padding:22rpx 24rpx; margin-bottom:12rpx; }
.decided-copy { display:block; font-size:22rpx; margin-top:5rpx; }
.decision { font-size:22rpx; }
.decision.confirmed { color:#1f765e; }
.decision.ignored { color:#999b96; }
