<view class="page-shell">
  <view class="review-header">
    <view><view class="eyebrow">商户映射</view><view class="title">待确认 {{pending.length}} 项</view></view>
    <button class="reset-button" bindtap="resetAll">重置本地</button>
  </view>
  <view class="intro">确认后的商户和分类目前保存在本地缓存。后续接入后端时，页面操作保持不变。</view>

  <view wx:if="{{!pending.length}}" class="empty-state card">已处理完所有 Mapping 建议</view>
  <view wx:for="{{pending}}" wx:key="id" class="review-card card">
    <view class="review-top"><text class="review-date">{{item.transactionDate}}</text><text class="review-amount">{{item.amountText}}</text></view>
    <view class="source-label">银行原始商户</view>
    <view class="source-merchant">{{item.sourceMerchant}}</view>
    <view class="arrow">↓</view>
    <view class="edit-field"><text>标准商户</text><input value="{{item.editMerchant || item.suggestedMerchant}}" placeholder="填写标准商户" data-id="{{item.id}}" bindinput="onMerchantInput" /></view>
    <view class="edit-field"><text>分类</text><picker range="{{categories}}" data-id="{{item.id}}" bindchange="onCategoryChange"><view>{{item.editCategory || item.suggestedCategory}} ›</view></picker></view>
    <view class="confidence"><text class="status-tag">{{item.status}}</text><text wx:if="{{item.score}}">匹配分 {{item.score}}</text></view>
    <view class="actions"><button class="ignore" data-id="{{item.id}}" bindtap="ignore">忽略</button><button class="confirm" data-id="{{item.id}}" bindtap="confirm">确认映射</button></view>
  </view>

  <view wx:if="{{decided.length}}" class="decided-title">已处理 {{decided.length}} 项</view>
  <view wx:for="{{decided}}" wx:key="id" class="decided-row card"><view><text>{{item.sourceMerchant}}</text><text class="muted decided-copy">{{item.merchant || item.decision}}</text></view><text class="decision {{item.decision}}">{{item.decision === 'confirmed' ? '已确认' : '已忽略'}}</text></view>
</view>
